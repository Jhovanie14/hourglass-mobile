{
  "manifest_version": 3,
  "name": "Hourglass Call Panel",
  "version": "3.0.0",
  "description": "Always-available call panel for Hourglass agents.",
  "minimum_chrome_version": "127",
  "key": "",
  "permissions": ["notifications", "offscreen", "storage", "tabs", "scripting"],
  "host_permissions": ["http://localhost:3000/*", "https://www.megestic.com/*"],
  "background": { "service_worker": "service-worker.js", "type": "module" },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content-widget.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["call-widget.html", "setup.html"],
      "matches": ["http://*/*", "https://*/*"]
    }
  ],
  "action": {
    "default_title": "Open Hourglass Call Panel",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
